# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY=your_perplexity_api_key_here     # Optional: Format: pplx-...
OPENAI_API_KEY=your_openai_api_key_here             # Optional, for OpenAI/OpenRouter models. Format: sk-proj-...
GOOGLE_API_KEY=your_google_api_key_here             # Optional, for Google Gemini models.
MISTRAL_API_KEY=your_mistral_key_here               # Optional, for Mistral AI models.
XAI_API_KEY=YOUR_XAI_KEY_HERE                       # Optional, for xAI AI models.
AZURE_OPENAI_API_KEY=your_azure_key_here            # Optional, for Azure OpenAI models (requires endpoint in .taskmasterconfig).

# ClearPass Sidekick MCP Server
CLEARPASS_SERVER=https://your-clearpass-server.com:443/api   # ClearPass Policy Manager API base URL
CLEARPASS_CLIENT_ID=your-oauth-client-id                     # OAuth2 client ID (or use CLEARPASS_API_TOKEN)
CLEARPASS_CLIENT_SECRET=your-oauth-client-secret             # OAuth2 client secret
CLEARPASS_VERIFY_SSL=true                                    # Verify TLS certs (default: true)

# Progressive disclosure: leave false so the 761 operations are exposed via the 3
# gateway meta-tools (list/describe/invoke_operation) instead of 761 direct tools.
# Set true to additionally register all 757 domain operations as direct MCP tools
# (pre-refactor behavior; large tool-schema context cost).
CLEARPASS_MCP_LEGACY_TOOLS=false